# Stripe secret key — get it from https://dashboard.stripe.com/apikeys
# Use a TEST key (starts with sk_test_) while developing.
# In production on Vercel, set this in Project → Settings → Environment Variables.
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# --- x402 bot paywall (middleware.js) — all optional, defaults shown ---
# X402_ENABLED=true                     # set to false to disable the paywall entirely
# X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
# X402_PRICE=$0.001                     # per request, USDC
# X402_NETWORK=eip155:8453              # Base mainnet
# X402_FACILITATOR_URL=https://x402.org/facilitator   # used only when CDP keys are not set
# Coinbase CDP facilitator (recommended; needed for Base mainnet settlement):
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
